{
  "table": "webchat_conversations",
  "primaryKey": "id",
  "recordTitle": "visitor_name",
  "hooks": "Quasar\\Hooks\\WebchatHooks",
  "actions": ["view", "edit", "delete", "export"],
  "menu": { "group": "main", "order": 3, "icon": "messages-square" },

  "scope": {
    "client": "webchat_conversations.client_id = {user.client_id}"
  },

  "chat": { "attachments": false },

  "fields": {
    "id":              { "type": "number", "readonly": true, "grouping": false },
    "visitor_name":    { "type": "text", "maxlength": 80, "width": "half" },
    "visitor_email":   { "type": "email", "maxlength": 150, "width": "half" },
    "status":          { "type": "select", "required": true, "default": "1", "width": "quarter",
                         "options": { "1": "status.open", "2": "status.closed" }, "colors": { "1": "green", "2": "gray" } },
    "client_id":       { "type": "select", "readonly": true, "width": "half", "access": ["equip"],
                         "source": { "table": "clients", "value": "id", "label": "name" } },
    "page_url":        { "type": "text", "readonly": true, "maxlength": 500 },
    "user_agent":      { "type": "text", "readonly": true, "maxlength": 255 },
    "last_message_at": { "type": "datetime", "readonly": true, "width": "half" },
    "created_at":      { "type": "datetime", "readonly": true, "width": "half" }
  },

  "list": {
    "columns": [
      { "field": "visitor_name", "minWidth": "180px" },
      { "field": "visitor_email", "maxWidth": "220px" },
      { "field": "client_id", "maxWidth": "200px" },
      { "field": "status", "width": "100px" },
      { "field": "last_message_at", "width": "140px" },
      { "field": "page_url", "maxWidth": "260px" }
    ],
    "defaultSort": { "field": "last_message_at", "dir": "desc" },
    "search": ["visitor_name", "visitor_email", "page_url"],
    "filters": [{ "field": "status" }, { "field": "client_id" }, { "field": "last_message_at", "operator": "between" }]
  },

  "form": {
    "sections": [
      { "title": "sections.visitor", "fields": ["visitor_name", "visitor_email", "status", "client_id"] },
      { "title": "sections.info", "fields": ["page_url", "user_agent", "last_message_at", "created_at"] }
    ]
  }
}

{
  "table": "files",
  "primaryKey": "id",
  "recordTitle": "title",
  "hooks": "Quasar\\Hooks\\FilesHooks",
  "actions": ["view", "create", "edit", "delete", "export"],
  "menu": { "group": "clients", "order": 28, "icon": "files", "access": ["equip"] },

  "scope": {
    "equip": true,
    "client": "files.client_id = {user.client_id}"
  },

  "fields": {
    "id":         { "type": "number", "readonly": true, "grouping": false },
    "folder_id":  { "type": "select", "required": true, "width": "half", "search": "remote",
                    "source": { "module": "folders", "value": "id", "label": "name" },
                    "dependsOn": { "field": "client_id", "column": "client_id" } },
    "client_id":  { "type": "select", "width": "half", "access": ["equip"], "search": "remote", "help": "help.client",
                    "source": { "module": "clients", "value": "id", "label": "name" } },
    "title":      { "type": "text", "maxlength": 150, "help": "help.title" },
    "file":       { "type": "media", "required": true, "multiple": true, "maxFiles": 50, "maxSize": "50M", "help": "help.file" },
    "notes":      { "type": "textarea", "rows": 3 },
    "created_at": { "type": "datetime", "readonly": true, "width": "half" }
  },

  "list": {
    "columns": ["title", { "field": "folder_id", "maxWidth": "220px" }, { "field": "client_id", "maxWidth": "220px" }, { "field": "file", "maxWidth": "240px" }, { "field": "created_at", "width": "140px" }],
    "expand": ["notes"],
    "defaultSort": { "field": "created_at", "dir": "desc" },
    "search": ["title", "notes"],
    "filters": [{ "field": "folder_id" }, { "field": "client_id" }]
  },

  "form": { "keepOnNew": ["client_id", "folder_id"], "fields": ["client_id", "folder_id", "file", "title", "notes", "created_at"] }
}
